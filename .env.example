# ===========================
# BASE DE DATOS (PostgreSQL)
# Cada cliente en el VPS tiene su propia DB.
# ===========================
DB_HOST=localhost
DB_PORT=5432
DB_USERNAME=postgres
DB_PASSWORD=
DB_NAME=punto_venta_db

# ===========================
# AUTENTICACIÓN
# Genera un secreto único por instancia:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# ===========================
JWT_SECRET=
JWT_EXPIRATION=24h

# ===========================
# SERVIDOR
# PORT: diferente por instancia en el VPS (demo=3000, clienteA=3001...)
# NODE_ENV: SIEMPRE 'production' en el VPS. 'development' en local.
# DB_DROP_SCHEMA: true SOLO en la primera inicialización (db:fresh).
#   ⚠️  Borra y recrea toda la BD. Nunca true en producción normal.
# ===========================
PORT=3000
NODE_ENV=development
DB_DROP_SCHEMA=false

# ===========================
# CLOUDINARY
# Una sola cuenta, carpeta diferente por cliente.
# CLOUDINARY_FOLDER — demo: 'products' | clienteA: 'primerclienteA/products'
# Si no se define, usa 'products' como fallback.
# ===========================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=products

# ===========================
# SEED INICIAL
# Solo tiene efecto al ejecutar db:fresh (NODE_ENV=development + DB_DROP_SCHEMA=true).
#
# SEED_MODE:
#   'demo'       → roles + usuarios ficticios + categorías + productos + historial.
#                  Usar en la instancia de demostración.
#   'production' → roles + 2 admins (definidos abajo) + 4 categorías base.
#                  El dueño crea productos, cajeros y cocineros desde el panel.
#                  Usar al onboardear un cliente real (ver .agent/deployment.md).
# ===========================
SEED_MODE=demo

SEED_ADMIN_NAME=Admin Sistema
SEED_ADMIN_EMAIL=admin@gmail.com
SEED_ADMIN_PASSWORD=ChangeMe2024!

SEED_OWNER_NAME=Dueño del Negocio
SEED_OWNER_EMAIL=owner@negocio.com
SEED_OWNER_PASSWORD=ChangeMe2024!
